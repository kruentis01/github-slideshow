# Copy to ~/.jobbot/.env (or a .env in the folder you run jobbot from) and fill in.
# Reed: free key from https://www.reed.co.uk/developers/jobseeker
REED_API_KEY=
# Adzuna: free app id and key from https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Optional: path to a Chromium/Chrome binary for `jobbot apply`
# JOBBOT_CHROMIUM=
